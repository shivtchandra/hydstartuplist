{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/cron/dispatch-scrape?scope=full", "schedule": "30 0 * * *" },
    { "path": "/api/cron/dispatch-scrape?scope=jobs&slot=06", "schedule": "30 6 * * *" },
    { "path": "/api/cron/dispatch-scrape?scope=jobs&slot=12", "schedule": "30 12 * * *" },
    { "path": "/api/cron/dispatch-scrape?scope=jobs&slot=18", "schedule": "30 18 * * *" }
  ],
  "functions": {
    "app/api/cron/**/*.js": {
      "maxDuration": 30
    },
    "app/api/**/*.js": {
      "maxDuration": 15
    }
  }
}
